#!/bin/bash
D="${MUESLI_FAKE_DATA:-$(cd "$(dirname "$0")/../data" && pwd)}"
echo "$*" >> "$D/calls.log"
env() { printf '{"ok":true,"command":"muesli-cli %s","data":%s,"meta":{"schemaVersion":1,"generatedAt":"2026-10-28T18:05:00Z","dbPath":"/Users/example/Library/Application Support/Muesli/muesli.db","warnings":[]}}\n' "$1" "$2"; }
fail() { printf '{"ok":false,"command":"muesli-cli %s","error":{"code":"%s","message":"%s","fix":"Run muesli-cli spec"},"meta":{"schemaVersion":1,"generatedAt":"2026-10-28T18:05:00Z","dbPath":"","warnings":[]}}\n' "$1" "$2" "$3"; exit 1; }
case "$1 $2" in
  "info "*) env info '{"version":"0.8.5","app":"Muesli"}' ;;
  "spec "*) env spec '{"commands":["info","spec","transcribe","meetings list","meetings get","meetings update-notes","dictations list","dictations get"]}' ;;
  "meetings list") env "meetings list" "$(cat "$D/meetings-list.json")" ;;
  "meetings get") [ -f "$D/meeting-$3.json" ] && env "meetings get $3" "$(cat "$D/meeting-$3.json")" || fail "meetings get $3" not_found "No meeting exists with id $3." ;;
  "dictations list") env "dictations list" "$(cat "$D/dictations-list.json")" ;;
  "dictations get") [ -f "$D/dictation-$3.json" ] && env "dictations get $3" "$(cat "$D/dictation-$3.json")" || fail "dictations get $3" not_found "No dictation exists with id $3." ;;
  "transcribe "*) f="$2"; case "$f" in *2026-10-28\ 15-02.m4a) t="Jo: I'm moving to the data platform team in January. Alex: Great, I'll introduce you to Priya before then. Jo: Thanks. I'll send you the migration doc by Monday.";; *) fail "transcribe" unsupported "Unknown audio";; esac
     if [[ "$*" == *"--format json"* ]]; then env transcribe "{\"transcript\":\"$t\",\"summary\":null,\"durationSeconds\":610,\"wordCount\":28,\"model\":\"parakeet-v3\",\"warnings\":[],\"savedMeetingID\":null,\"title\":\"2026-10-28 15-02\"}"; else echo "$t"; fi ;;
  "meetings update-notes") fail "meetings update-notes" forbidden_in_test "write attempted" ;;
  *) fail "$*" unknown_command "Unknown command" ;;
esac
